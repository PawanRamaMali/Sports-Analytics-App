# Copy to .env.local for local runs (never committed). Variables already set
# in the environment win over this file.

# First admin, created on first start when the users file is empty.
SPORTS_ADMIN_USER=admin
SPORTS_ADMIN_PASSWORD=change-me-please

# Where users and season files live (defaults shown). In production, point
# both at persistent storage outside the deployed bundle.
# SPORTS_USERS_FILE=data/users.csv
# SPORTS_DATA_DIR=data/seasons
